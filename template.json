{
  "schemaVersion": 1,
  "id": "brand",
  "category": "brand",
  "name": {
    "en-US": "LUMIÈRE · Beauty lookbook",
    "zh-CN": "LUMIÈRE · 美妆妆容手册",
    "ko-KR": "LUMIÈRE · 뷰티 룩북"
  },
  "description": {
    "en-US": "An editorial DTC beauty lookbook with signature looks, application steps and related products.",
    "zh-CN": "编辑式美妆 DTC 妆容手册，包含标志性妆容、复刻步骤与关联产品。",
    "ko-KR": "시그니처 룩, 재현 단계, 관련 제품을 담은 편집적인 DTC 뷰티 룩북."
  },
  "repository": "https://github.com/InYourWork/websites",
  "branch": "templates/brand",
  "stack": "react-vite",
  "contentEntry": "src/content/locales/",
  "styleEntry": "src/styles/tokens.css",
  "outputDirectory": "dist",
  "features": [
    "responsive-navigation",
    "announcement-bar",
    "lookbook-grid",
    "collection-filter",
    "look-detail",
    "look-detail-hero",
    "shop-plp",
    "product-pdp",
    "category-filter",
    "add-to-bag-prototype",
    "product-to-looks-relation",
    "application-steps",
    "related-products",
    "virtual-try-on",
    "social-grid",
    "shoppable-social-lightbox",
    "fan-faves-carousel",
    "autoplay-video-carousel",
    "layered-video-player",
    "email-signup-prototype",
    "brand-story",
    "faq",
    "email-contact",
    "multilingual",
    "shopping-bag-drawer",
    "checkout-prototype",
    "persistent-cart"
  ],
  "requiredRuntimeCapabilities": [],
  "designReference": "https://kyliecosmetics.com/en-cn/pages/kylies-looks",
  "localeConfig": "src/content/config.json",
  "pages": {
    "home": "/",
    "collection": "/collections/",
    "content": "/collections/{id}/",
    "shop": "/shop/",
    "product": "/products/{id}/",
    "story": "/story/",
    "checkout": "/checkout/"
  },
  "rendering": "static-generation"
}
